# LightHouse control-plane PostgreSQL database.
LIGHTHOUSE_DATABASE_URL=postgresql://lighthouse:lighthouse@127.0.0.1:5432/lighthouse

# Bearer token accepted by the HTTP gateway. Generate a long random value.
LIGHTHOUSE_API_KEY=replace-me-with-at-least-16-characters

# Optional default bind settings.
LIGHTHOUSE_HOST=127.0.0.1
LIGHTHOUSE_PORT=8787

# Optional Chat-Completions-compatible model provider.
LIGHTHOUSE_MODEL_BASE_URL=https://api.example.com/v1
LIGHTHOUSE_MODEL_API_KEY=replace-model-secret
LIGHTHOUSE_MODEL=your-model-name
LIGHTHOUSE_MODEL_TIMEOUT=120
LIGHTHOUSE_MODEL_JSON_MODE=1
LIGHTHOUSE_MODEL_MAX_STATE_CHARS=120000

# Example target secrets. Targets reference these names; values never enter the DB.
WAREHOUSE_DATABASE_URL=postgresql://warehouse:secret@db.internal:5432/warehouse
WAREHOUSE_SSH_KEY=/run/secrets/warehouse_ssh_key
WAREHOUSE_KNOWN_HOSTS=/run/secrets/known_hosts
